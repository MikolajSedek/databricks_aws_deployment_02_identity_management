/*
  Databricks Account-Level Service Principals
  Documentation: https://registry.terraform.io/providers/databricks/databricks/latest/docs/resources/service_principal

  Creates one databricks_service_principal per entry of var.service_principals (for_each over the map key).
  The application ID is generated by Databricks on AWS.
*/

resource "databricks_service_principal" "this" {
  for_each = var.service_principals // key = logical identifier referenced by memberships and rule sets

  display_name = each.value.display_name
  active       = each.value.active
  external_id  = each.value.external_id
}
